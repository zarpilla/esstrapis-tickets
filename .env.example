# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Set to 1 when running behind nginx (needed for correct client IPs in login rate limiting)
TRUST_PROXY=1

# openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=168

# SSO from ESSTRAPIS: the same secret as TICKETS_SSO_KEY in every instance (openssl rand -base64 48).
# Empty = SSO off.
TICKETS_SSO_KEY=

# Bearer key for /api/v1 (the team's projectes/issues sync), 32+ chars: openssl rand -base64 48.
# Not the SSO key: this one reads and writes every ticket. Empty = API off.
TICKETS_API_KEY=

# z.ai (GLM). Use https://api.z.ai/api/coding/paas/v4 if the key belongs to a Coding Plan.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1
# Optional: a vision model (e.g. glm-5v-turbo) so the AI also looks at uploaded screenshots
ZAI_VISION_MODEL=
ZAI_TIMEOUT_MS=90000
# How long opening a ticket waits for a missing Catalan translation before showing the English text
ZAI_TRANSLATE_WAIT_MS=30000

# Where issues/, uploads/ and users.json live (back this folder up)
DATA_DIR=./data
# First id to use, e.g. 100 to avoid clashing with ids in projectes/issues
ISSUE_ID_START=1
PROJECTS=projectes-front, projectes-v5
UPLOAD_MAX_MB=10
UPLOAD_MAX_FILES=8
TZ_ISSUES=Europe/Madrid

# Email notifications (off when SMTP_HOST is empty). Users whose username is an
# email get an email when their tickets change; admins with an email get all changes.
PUBLIC_URL=https://tiquets.example.org
SMTP_HOST=
SMTP_PORT=587
# 1 for port 465 (implicit TLS); leave empty for 587 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ESSTRAPIS Tiquets <tiquets@example.org>"
